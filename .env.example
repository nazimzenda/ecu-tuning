# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
DATA_DIR=
API_PORT=4000
CLIENT_PORT=3000
ADMIN_PORT=3001
ADMIN_SESSION_TTL_MS=43200000

# Required in production. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# --- API URLs --------------------------------------------------------------
# Leave empty in production when nginx serves the UI and proxies /api on the
# same origin. Set explicitly when the UI and API are on different hosts.
CLIENT_API_BASE_URL=
ADMIN_API_BASE_URL=
ADMIN_URL=

# Comma-separated CORS allowlist for a split UI/API deployment.
# Leave empty for same-origin production or localhost development.
ALLOWED_ORIGINS=

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="AZ Performance <onboarding@resend.dev>"
ADMIN_EMAIL=

# SMTP fallback for local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- WhatsApp (Twilio, optional) -------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Firebase / Firestore (optional) ---------------------------------------
USE_FIREBASE=0
GOOGLE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# --- Lead research ---------------------------------------------------------
LEAD_RESEARCH_CONTACT=
