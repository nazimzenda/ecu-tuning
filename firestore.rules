rules_version = '2';

// The API is the only client of Firestore and authenticates with the Admin
// SDK, which bypasses security rules. Browsers never talk to Firestore
// directly, so deny every client-side read/write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
